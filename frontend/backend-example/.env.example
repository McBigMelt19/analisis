# Variables de entorno para el backend
# Copia este archivo a .env y configura tus valores

# Puerto del servidor (Render lo asigna automáticamente)
PORT=3000

# URL de Ollama
# Desarrollo local: http://localhost:11434
# Producción: https://tu-ollama-server.onrender.com
OLLAMA_URL=http://localhost:11434

# URL del frontend (para CORS)
# Desarrollo: http://localhost:5173
# Producción: https://tu-app.netlify.app
FRONTEND_URL=http://localhost:5173

# Base de datos (cuando migres de db.json)
# DATABASE_URL=postgresql://user:password@host:5432/database
