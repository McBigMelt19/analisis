# Configuración de API
# Cambia VITE_API_MODE a "backend" para conectar al backend Express real
# Cambia VITE_API_MODE a "local" para usar json-server local (solo datos mock)
VITE_API_MODE=backend
VITE_API_URL_LOCAL=http://localhost:3001
VITE_API_URL_BACKEND=http://localhost:5001/api

# Ollama (IA local)
VITE_OLLAMA_URL=http://localhost:11434/api/chat
