# Configuración de API
# Cambia VITE_API_MODE a "render" para conectar al backend en producción
# Cambia VITE_API_MODE a "local" para usar json-server local
VITE_API_MODE=local
VITE_API_URL_LOCAL=http://localhost:3001
VITE_API_URL_RENDER=https://iahistoriabackend.onrender.com/api

# Ollama (IA local)
VITE_OLLAMA_URL=http://localhost:11434/api/chat
