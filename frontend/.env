# Configuración de API
# Cambia VITE_API_MODE a "render" para conectar al backend Express real
# Cambia VITE_API_MODE a "local" para usar json-server local (solo datos mock)
VITE_API_MODE=render
VITE_API_URL_LOCAL=http://localhost:5000/api
VITE_API_URL_RENDER=https://iahistoriabackend.onrender.com/api

# Ollama (IA local)
VITE_OLLAMA_URL=http://localhost:11434/api/chat
